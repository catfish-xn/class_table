{
  "name": "class-table",
  "version": "1.0.0",
  "private": true,
  "description": "教培老师课表工具：周课表、上课记录与月统计（Cloudflare Workers + D1）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply class_table --local",
    "db:migrate:remote": "wrangler d1 migrations apply class_table --remote",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
